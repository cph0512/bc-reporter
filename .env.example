# Business Central 連線設定
# 在 Azure Portal → App Registrations 取得以下資訊

BC_TENANT_ID=your-azure-tenant-id
BC_CLIENT_ID=your-app-registration-client-id
BC_CLIENT_SECRET=your-client-secret
BC_ENVIRONMENT=Production
BC_COMPANY_ID=your-bc-company-guid

# LINE Bot（選填，不填則不啟用 LINE 功能）
LINE_CHANNEL_SECRET=your-line-channel-secret
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token

# AI 名片掃描（選填，不填則不啟用掃描功能）
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Security（生產環境必填）
SESSION_SECRET=your-random-session-secret
SYNC_SECRET=your-random-sync-secret

# CORS 白名單（選填，逗號分隔，不填則允許所有來源）
# CORS_ORIGINS=https://your-app.railway.app,https://your-domain.com

# Server
PORT=3000
