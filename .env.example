# Business Central 連線設定
# 在 Azure Portal → App Registrations 取得以下資訊

BC_TENANT_ID=your-azure-tenant-id
BC_CLIENT_ID=your-app-registration-client-id
BC_CLIENT_SECRET=your-client-secret
BC_ENVIRONMENT=Production
BC_COMPANY_ID=your-bc-company-guid

# LINE Bot（選填，不填則不啟用 LINE 功能）
LINE_CHANNEL_SECRET=your-line-channel-secret
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token

# AI 名片掃描（選填，不填則不啟用掃描功能）
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# AI 費用附件辨識（預設使用 OpenAI-compatible/Qwen，不使用 Gemini）
# 可直接沿用 SALES PA01 bot 的 LINE_DIRECT_API_* 設定值
EXPENSE_SCAN_PROVIDER=qwen
EXPENSE_SCAN_API_URL=https://your-openai-compatible-host/v1/chat/completions
EXPENSE_SCAN_API_KEY=your-qwen-api-key
EXPENSE_SCAN_MODEL=qwen3.6-plus

# Security（生產環境必填）
SESSION_SECRET=your-random-session-secret
SYNC_SECRET=your-random-sync-secret

# CORS 白名單（選填，逗號分隔，不填則允許所有來源）
# CORS_ORIGINS=https://your-app.railway.app,https://your-domain.com

# Server
PORT=3000
